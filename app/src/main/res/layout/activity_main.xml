<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?android:attr/colorBackground"
    android:orientation="vertical">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="@dimen/screen_padding_horizontal"
            android:paddingTop="@dimen/screen_padding_vertical"
            android:paddingBottom="32dp">

            <!-- 品牌行 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:minHeight="@dimen/toolbar_height"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="@dimen/brand_logo_size"
                    android:layout_height="@dimen/brand_logo_size"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_logo"
                    android:contentDescription="@string/app_name" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1"
                    android:text="@string/app_name"
                    android:textAppearance="@style/TextAppearance.Material3.HeadlineSmall"
                    android:textStyle="bold" />

                <!-- 主题切换：单击在 跟随系统 → 浅色 → 深色 之间循环。
                     放这里是因为它不属于任何一个 hub，而且是个高频小操作。 -->
                <ImageButton
                    android:id="@+id/btnTheme"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_marginEnd="6dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/entry_theme"
                    android:padding="8dp"
                    android:src="@drawable/ic_theme"
                    app:tint="?attr/colorOnSurfaceVariant" />

                <TextView
                    android:id="@+id/tvPhase"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_phase_chip"
                    android:paddingHorizontal="12dp"
                    android:paddingVertical="6dp"
                    android:textAppearance="@style/TextAppearance.Material3.LabelMedium"
                    android:textColor="?attr/colorOnSurfaceVariant" />
            </LinearLayout>

            <!-- 主开关大卡片 -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardAction"
                style="@style/Widget.GuGuGuClash.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:clickable="true"
                android:focusable="true"
                android:minHeight="88dp"
                app:cardBackgroundColor="?attr/colorPrimaryContainer">

                <include
                    layout="@layout/view_action_card"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />
            </com.google.android.material.card.MaterialCardView>

            <!-- 流量：单独成块，用户最关心的一项 -->
            <include
                                layout="@layout/view_traffic_card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/card_gap" />

            <!-- 指标：接管与硬件加速并排 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/card_gap"
                android:orientation="horizontal">

                <include
                    android:id="@+id/statRules"
                    layout="@layout/item_stat"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1" />

                <include
                    android:id="@+id/statHint"
                    layout="@layout/item_stat"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/card_gap"
                    android:layout_weight="1" />
            </LinearLayout>


            <!-- 运行 -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/section_gap"
                android:layout_marginBottom="4dp"
                android:text="@string/section_runtime"
                android:textAppearance="@style/TextAppearance.GuGuGuClash.Section" />

            <LinearLayout
                android:id="@+id/groupRuntime"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

            <!-- 配置 -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/section_gap"
                android:layout_marginBottom="4dp"
                android:text="@string/section_config"
                android:textAppearance="@style/TextAppearance.GuGuGuClash.Section" />

            <LinearLayout
                android:id="@+id/groupConfig"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

            <!-- 排障 -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/section_gap"
                android:layout_marginBottom="4dp"
                android:text="@string/section_advanced"
                android:textAppearance="@style/TextAppearance.GuGuGuClash.Section" />

            <LinearLayout
                android:id="@+id/groupAdvanced"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
